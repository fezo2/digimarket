// Digimarket data model.
// Money is stored as integer piasters (1 EGP = 100 piasters).
// Commission rates are stored in basis points (1000 = 10%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum SellerType {
  INDIVIDUAL
  COMPANY
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum PayoutMethod {
  INSTAPAY
  BANK_TRANSFER
  MOBILE_WALLET
}

enum DeliveryType {
  UNIQUE_CODES // each buyer receives a different code / account from stock
  FILE // same file for every buyer
  TEXT // same text / instructions for every buyer
  LINK // external link revealed after payment
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  PAUSED
}

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum LedgerType {
  SALE
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUND
  RESOLVED_NO_REFUND
  CLOSED_BY_BUYER
}

model User {
  sessionVersion  Int       @default(0)
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String
  // Null until the owner opens the link we email at sign up.
  emailVerifiedAt DateTime?
  role            Role      @default(BUYER)
  createdAt       DateTime  @default(now())
  suspendedAt     DateTime?
  suspendReason   String?
  adminNote       String?

  seller   SellerProfile?
  orders   Order[]
  reviews  Review[]
  messages Message[]
  disputes Dispute[]
}

model SellerProfile {
  telegramLinkedAt DateTime?
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName        String
  slug             String     @unique
  description      String?
  logoUrl          String?
  type             SellerType @default(INDIVIDUAL)
  kycStatus        KycStatus  @default(NOT_SUBMITTED)
  verifiedAt       DateTime?
  telegramChatId   String?
  businessHours    String?
  createdAt        DateTime   @default(now())

  positiveReviews  Int           @default(0)
  negativeReviews  Int           @default(0)
  payoutMethod     PayoutMethod?
  payoutAccount    String?
  payoutHolderName String?
  payoutUpdatedAt  DateTime?

  // Admin controls. Null means the platform default applies.
  salesSuspendedAt    DateTime?
  salesSuspendReason  String?
  payoutsFrozenAt     DateTime?
  payoutsFrozenReason String?
  commissionBps       Int?
  holdDays            Int?

  kycSubmissions KycSubmission[]
  products       Product[]
  orderItems     OrderItem[]
  ledger         LedgerEntry[]
  payouts        Payout[]
  coupons        Coupon[]
  reviews        Review[]
  replies        SellerReply[]
}

// Canned chat answers a seller drops into an order conversation.
model SellerReply {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime      @default(now())

  @@index([sellerId, createdAt])
}

model KycSubmission {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type     SellerType

  fullName   String
  nationalId String
  phone      String
  idFrontKey String
  idBackKey  String
  selfieKey  String

  // Companies only
  companyName      String?
  commercialRegNo  String?
  taxCardNo        String?
  commercialRegKey String?
  taxCardKey       String?

  payoutMethod      PayoutMethod
  payoutAccount     String
  payoutAccountName String

  status       KycStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([status, submittedAt])
}

model Category {
  id            String     @id @default(cuid())
  slug          String     @unique
  nameAr        String
  nameEn        String
  icon          String?
  imageUrl      String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  commissionBps Int        @default(1000)
  sortOrder     Int        @default(0)
  products      Product[]
}

model Product {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  slug            String        @unique
  title           String
  description     String
  imageUrl        String?
  price           Int
  compareAtPrice  Int?
  deliveryType    DeliveryType
  // Content revealed after payment for FILE / TEXT / LINK products.
  deliveryContent String?
  instructions    String?
  status          ProductStatus @default(DRAFT)
  reviewNote      String?
  salesEnabled    Boolean       @default(true)
  minQty          Int           @default(1)
  maxQty          Int           @default(10)
  soldCount       Int           @default(0)
  positiveReviews Int           @default(0)
  negativeReviews Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Set when the product is resold from an outside supplier (src/lib/supplier.ts):
  // no stock codes are kept here, each paid order is bought from the supplier.
  supplier          String?
  supplierProductId String?
  supplierCostMills Int? // supplier unit price in 1/1000 USD
  supplierStock     Int?
  supplierSyncedAt  DateTime?

  options           ProductOption[]
  stock             StockItem[]
  quantityDiscounts QuantityDiscount[]
  orderItems        OrderItem[]
  reviews           Review[]

  @@unique([supplier, supplierProductId])
  @@index([status, categoryId])
  @@index([sellerId])
}

// Buyer-facing choice such as duration ("1 month" / "12 months") that can change the price,
// or a text field the buyer must fill (e.g. the email to upgrade).
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  kind      String               @default("select") // "select" | "text"
  required  Boolean              @default(true)
  sortOrder Int                  @default(0)
  values    ProductOptionValue[]
}

model ProductOptionValue {
  id         String        @id @default(cuid())
  optionId   String
  option     ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Int           @default(0)
  sortOrder  Int           @default(0)
}

model QuantityDiscount {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty     Int
  percentOff Int
}

model StockItem {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  content     String
  status      StockStatus @default(AVAILABLE)
  orderItemId String?
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id])
  createdAt   DateTime    @default(now())
  soldAt      DateTime?

  @@index([productId, status])
}

model Coupon {
  id         String         @id @default(cuid())
  code       String         @unique
  sellerId   String?
  seller     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  percentOff Int?
  amountOff  Int?
  minTotal   Int            @default(0)
  usageLimit Int?
  usedCount  Int            @default(0)
  expiresAt  DateTime?
  active     Boolean        @default(true)
  orders     Order[]
}

model Order {
  id              String         @id @default(cuid())
  number          Int            @unique @default(autoincrement())
  buyerId         String
  buyer           User           @relation(fields: [buyerId], references: [id])
  status          OrderStatus    @default(PENDING_PAYMENT)
  subtotal        Int
  discount        Int            @default(0)
  total           Int
  couponId        String?
  coupon          Coupon?        @relation(fields: [couponId], references: [id])
  paymentProvider String?
  paymentRef      String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  items           OrderItem[]
  messages        Message[]
  expiresAt       DateTime
  refundedAt      DateTime?
  refundNote      String?
  // When the buyer actually got the money back. Admin refunds are recorded
  // after paying; seller refunds wait here until the admin transfers.
  refundPaidAt    DateTime?
  reviewReason    String?
  paidAmount      Int?
  // Where the buyer checked out from, shown on the seller's order page.
  buyerIp         String?
  buyerCountry    String?
  manualPayment   ManualPayment?
  // Manual (InstaPay / wallet) orders: the account the buyer says they pay
  // from, and the exact amount asked for (total plus a few unique piasters)
  // so a forwarded transfer SMS can be matched to this order on its own.
  payFrom         String?
  payAmount       Int?

  @@index([status, expiresAt])
  @@index([paymentProvider, payAmount])
  @@index([buyerId, createdAt])
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id])
  title            String
  quantity         Int
  unitPrice        Int
  total            Int
  commissionBps    Int
  commissionAmount Int
  sellerNet        Int
  optionsJson      String?
  refundedAmount   Int           @default(0)
  deliveredAt      DateTime?
  deliveryType     DeliveryType
  deliveryContent  String?
  instructions     String?
  // Supplier purchase for resold products. The attempt number is part of the
  // idempotency key, so a retry after a network error never buys twice.
  supplier         String?
  supplierOrderId  String?
  supplierAttempt  Int           @default(0)
  supplierError    String?

  stockItems StockItem[]
  review     Review?
  disputes   Dispute[]
  ledger     LedgerEntry[]

  @@index([sellerId])
}

model Review {
  id            String        @id @default(cuid())
  orderItemId   String        @unique
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User          @relation(fields: [buyerId], references: [id])
  positive      Boolean
  comment       String?
  sellerReply   String?
  updatedAt     DateTime?
  editedOnce    Boolean       @default(false)
  sellerReplyAt DateTime?
  hiddenAt      DateTime?
  hiddenReason  String?
  createdAt     DateTime      @default(now())

  @@index([productId, createdAt])
  @@index([sellerId, createdAt])
}

enum MessageKind {
  USER
  SYSTEM
}

model Message {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  body          String
  kind          MessageKind @default(USER)
  attachmentKey String?
  flagged       Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Dispute {
  id           String        @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User          @relation(fields: [buyerId], references: [id])
  reason       String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status, createdAt])
  @@index([orderItemId])
}

// Every money movement for a seller. Balance = sum(amount);
// withdrawable = sum(amount where availableAt <= now).
model LedgerEntry {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type        LedgerType
  amount      Int
  availableAt DateTime      @default(now())
  orderItemId String?
  orderItem   OrderItem?    @relation(fields: [orderItemId], references: [id])
  payoutId    String?
  payout      Payout?       @relation(fields: [payoutId], references: [id])
  note        String?
  createdAt   DateTime      @default(now())

  @@index([sellerId, createdAt])
  @@index([sellerId, availableAt])
}

model Payout {
  id            String        @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount        Int
  method        PayoutMethod
  account       String
  status        PayoutStatus  @default(REQUESTED)
  reference     String?
  note          String?
  createdAt     DateTime      @default(now())
  processedAt   DateTime?
  ledger        LedgerEntry[]
  holderName    String
  rejectReason  String?
  processedById String?

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  data      String?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model OrderRead {
  orderId    String
  userId     String
  lastReadAt DateTime

  @@id([orderId, userId])
}

model TelegramLinkToken {
  token     String    @id
  sellerId  String
  expiresAt DateTime
  usedAt    DateTime?
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationChannel {
  TELEGRAM
}

model Notification {
  id            String              @id @default(cuid())
  sellerId      String
  channel       NotificationChannel @default(TELEGRAM)
  event         String
  payload       String
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A sign-up waiting for its emailed code. The User row is only created once
// the code is entered, so unconfirmed addresses never reach the users table.
model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  next         String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

enum ManualMethod {
  INSTAPAY
  WALLET
}

enum ManualPaymentStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

// A buyer's claim that they transferred the order total by hand; an admin
// confirms it against the real InstaPay / wallet statement.
model ManualPayment {
  id             String              @id @default(cuid())
  orderId        String              @unique
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         ManualMethod
  senderAccount  String
  reference      String
  receiptKey     String
  status         ManualPaymentStatus @default(SUBMITTED)
  receivedAmount Int?
  reviewNote     String?
  reviewedById   String?
  createdAt      DateTime            @default(now())
  reviewedAt     DateTime?

  @@unique([method, reference])
  @@index([status, createdAt])
}

enum PaymentNoticeStatus {
  MATCHED
  UNMATCHED
  IGNORED
}

// A transfer SMS or app notification forwarded from the platform's phone.
// Matched notices confirmed an order automatically.
model PaymentNotice {
  id        String              @id @default(cuid())
  textHash  String              @unique
  sender    String?
  text      String
  amount    Int?
  status    PaymentNoticeStatus
  orderId   String?
  note      String?
  createdAt DateTime            @default(now())

  @@index([createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@index([active, createdAt])
}

// One row per supplier (id = "prodseller"): which store resells it and how
// supplier prices in USD become store prices in piasters.
model SupplierSettings {
  id        String   @id
  sellerId  String?
  usdRate   Int      @default(5500) // piasters per 1 USD
  multiplierBps Int @default(25000) // 25000 = store price is 2.5x the cost
  updatedAt DateTime @updatedAt
}
