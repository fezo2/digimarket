DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/digimarket"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
STORAGE_DIR="./storage"

# test (development only), manual (InstaPay / wallet transfers confirmed by an admin) or paymob.
PAYMENT_PROVIDER="test"
# Manual payments: set one or both. InstaPay address (name@instapay) or mobile; wallet mobile 01xxxxxxxxx.
MANUAL_INSTAPAY=""
MANUAL_WALLET=""
APP_URL="http://localhost:3000"
# Optional: public support address shown on /pages/contact.
SUPPORT_EMAIL=""
# Optional: serve the seller portal and admin panel on their own hosts.
# Set both or neither. Each host keeps its own sign-in.
SELLER_URL=""
ADMIN_URL=""
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_IDS=""

# Direct PostgreSQL connection for migrations; may equal DATABASE_URL locally.
DIRECT_URL=""
# Private storage: local (default in development) or r2 (required in production).
STORAGE_DRIVER=""
# Cloudflare R2 account identifier.
R2_ACCOUNT_ID=""
# R2 API access key scoped only to the private bucket.
R2_ACCESS_KEY_ID=""
# R2 API secret; never commit a real value.
R2_SECRET_ACCESS_KEY=""
# Private R2 bucket name.
R2_BUCKET=""
# Random bearer secret used by Vercel Cron.
CRON_SECRET=""
# Telegram bot token; leave all three Telegram settings empty to disable.
TELEGRAM_BOT_TOKEN=""
# Telegram bot username without @.
TELEGRAM_BOT_USERNAME=""
# Random Telegram setWebhook secret_token value.
TELEGRAM_WEBHOOK_SECRET=""
# Resend API key; leave both email settings empty to hide password recovery.
RESEND_API_KEY=""
# Verified Resend sender address.
EMAIL_FROM=""

# Optional: your own Telegram chat id (from @userinfobot) for instant alerts
# when a buyer submits a manual transfer. Uses TELEGRAM_BOT_TOKEN.
ADMIN_TELEGRAM_CHAT_ID=""
# Google Search Console "HTML tag" verification: only the content="..." value.
GOOGLE_SITE_VERIFICATION=""
